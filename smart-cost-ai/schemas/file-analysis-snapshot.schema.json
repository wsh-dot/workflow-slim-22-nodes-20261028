{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "0902 FileAnalysisSnapshot 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "provenance", "source", "structure", "row_map", "items", "item_contexts", "cbs", "unresolved", "scope_completeness"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["file_id", "project_id", "batch_id", "task_id", "request_id", "input_revision", "input_fingerprint", "classification_rules_fingerprint", "model"],
      "properties": {
        "file_id": {"type": "string", "minLength": 1},
        "project_id": {"type": "string", "minLength": 1},
        "batch_id": {"type": "string", "minLength": 1},
        "task_id": {"type": "string", "minLength": 1},
        "request_id": {"type": ["string", "null"]},
        "input_revision": {"type": "integer", "minimum": 1},
        "result_revision": {"type": "integer", "minimum": 1},
        "input_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "items_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "classification_rules_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "model": {"type": "object"}
      }
    },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["header", "raw_rows"],
      "properties": {
        "header": {"type": "object"},
        "raw_rows": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "orderno"], "properties": {"id": {"type": "string", "minLength": 1}, "orderno": {"type": "integer"}}}}
      }
    },
    "structure": {"type": "object", "required": ["rows"], "properties": {"rows": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["r", "role", "parent"], "properties": {"r": {"type": "integer", "minimum": 1}, "role": {"enum": ["project", "section", "group", "summary", "item", "assembly", "component", "attribute", "note", "pending"]}, "parent": {"type": ["integer", "null"]}}}}}},
    "row_map": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["r", "raw_id", "item_id", "source_order", "role"], "properties": {"r": {"type": "integer", "minimum": 1}, "raw_id": {"type": "string"}, "item_id": {"type": ["string", "null"]}, "source_order": {"type": "integer"}, "role": {"type": "string"}}}},
    "items": {"type": "array", "items": {"type": "object", "required": ["id", "file_id", "parent_id", "name", "type", "quantity", "unit", "project_cbs_id"]}},
    "item_contexts": {"type": "object", "additionalProperties": {"type": "object", "required": ["primary_raw_id", "source_order", "source_raw_ids", "evidence_raw_ids", "original_role", "original_parent", "scope", "measurement", "calculated_quantity", "physical_quantity", "supply_scope"], "properties": {"primary_raw_id": {"type": "string"}, "source_order": {"type": "integer"}, "source_raw_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "evidence_raw_ids": {"type": "array", "items": {"type": "string"}}, "scope": {"type": "object"}, "measurement": {"type": "object"}}}},
    "cbs": {"type": "object"},
    "unresolved": {"type": "array", "items": {"type": "object"}},
    "scope_completeness": {"type": "object", "required": ["status", "missing_fields", "reason"]}
  }
}
