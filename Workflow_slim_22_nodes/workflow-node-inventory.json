  "entry_phases": [
    "STRUCTURE_INITIAL",
    "STRUCTURE_REPAIR",
    "CBS_LEAF",
    "CBS_PARENT",
    "RETURN"
  ],
  "runtime_rules": {
    "one_file_per_dispatch": true,
    "normal_model_calls": 3,
    "max_semantic_repairs": 1,
    "repair_reuses_structure_node": true,
    "technical_retries_separate_budget": true,
    "initial_global_single_file_runs": 4,
    "concurrency_is_unverified_initial_value": true,
    "all_run_outcomes_reconciled_by_service": true,
    "business_completion_source": "durable_file_job_state",
    "publish_once_per_build_generation": true,
    "old_dispatch_late_writes_rejected": true,
    "same_name_leaf_judgment_consistency": true,
    "cbs_unattached_does_not_force_review": true,
    "freeze_execution_config_across_runs": true,
    "stop_ack_is_not_terminal": true,
    "response_mode": "streaming",
    "version_pin_modes": [
      "WORKFLOW_ID",
      "IMMUTABLE_APP"
    ]
  },
  "notes": [
    "本清单描述拟实施配置，非已部署DSL。",
    "22节点以模型提供完整text为前提；仅对象输出增加3个安全序列化节点。",
    "技术异常由服务统一查证和有界恢复；职责迁移不等于取消校验。",
    "End仅返回入口身份，各分支不汇合可能未执行的业务变量。",
    "同名候选判断冲突返回未挂接并保留完整树；semanticStatus只反映来源树质量。",
    "停止使用task_id和原user；纠正及恢复绑定原workflow_id和execution_config_id。"
  ],
  "runtime_identity_fields": [
    "dispatch_id",
    "file_job_id",
    "workflow_run_id",
    "task_id",
    "workflow_id",
    "observed_workflow_id",
    "execution_config_id",
    "dify_user",
    "dify_app_id",
    "credential_ref"
  ],
  "internal_http_headers": [
